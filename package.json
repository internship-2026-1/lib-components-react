  "scripts": {
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "dev": "vite --config example/vite.config.ts",
    "prepare": "npm run build",
    "test": "echo \"No tests configured\""
  },
  "peerDependencies": {
    "react": "^18 || ^17",
    "react-dom": "^18 || ^17"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
